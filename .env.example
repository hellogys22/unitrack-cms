# PostgreSQL Database Connection String
# Local development with Prisma Local Postgres (`npx prisma dev`) or local PostgreSQL:
# DATABASE_URL="postgresql://postgres:postgres@localhost:5432/unitrack_cms?schema=public"
#
# Production (Vercel Postgres / Neon / Supabase):
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require"
